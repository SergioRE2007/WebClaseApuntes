# ---- Supabase (Project Settings → API) ----
# IMPORTANTE: las variables NEXT_PUBLIC_* se incrustan al hacer el BUILD.
# Tienen que existir también en el entorno de build (Vercel/Docker), no solo al arrancar.
# Si faltan en producción, la web responde 503 (no se abre en "modo demo").
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. NUNCA lo publiques ni lo pongas con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ---- Claude (console.anthropic.com → API Keys) ----
ANTHROPIC_API_KEY=

# ---- Clase ----
# Código que tus compañeros meten al registrarse por primera vez.
# Que sea largo y aleatorio (12+ caracteres, p. ej. DAM-7Q4K-9XPM); no distingue mayúsculas.
# Cada cuenta tiene como mucho 10 intentos al día.
CLASE_CODIGO=DAM-CAMBIAME-XXXX
# Mensajes de chat por alumno y día
CHAT_LIMITE_DIARIO=40

# URL pública (para los enlaces del email de login)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Modo demo ----
# Sin Supabase, en desarrollo la web funciona como admin ficticio. En producción está
# desactivado salvo que pongas DAM_DEMO=1 (solo para demos locales: ¡cualquiera es admin!).
# DAM_DEMO=1
